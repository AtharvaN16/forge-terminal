{
  "name": "forge-terminal",
  "version": "0.1.0",
  "description": "A terminal-native file converter for macOS",
  "type": "module",
  "bin": { "forge": "./dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "sharp": "^0.35.3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
