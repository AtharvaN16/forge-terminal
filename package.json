{
  "name": "forge-terminal",
  "version": "0.5.1",
  "description": "A terminal-native file converter for macOS, Windows and Linux",
  "whatsNew": [
    {
      "title": "Boost on every Linux",
      "text": "Boost now works on any Linux PC, ARM ones like a Raspberry Pi too, and uses the graphics card when there is a real one."
    },
    {
      "title": "Forge’s own ffmpeg",
      "text": "No ffmpeg on your Apple silicon Mac? Forge can now download its own copy for video and sound, in one step."
    },
    {
      "title": "Notes card colour",
      "text": "On /update, the release notes card stays grey whichever mode you opened the menu from."
    },
    {
      "title": "Safer MCP server",
      "text": "The MCP server uses a fixed zod, which could run out of memory on an oversized request."
    }
  ],
  "keywords": [
    "convert",
    "converter",
    "image",
    "heic",
    "webp",
    "pdf",
    "docx",
    "compress",
    "cli",
    "terminal",
    "tui",
    "macos",
    "windows",
    "linux"
  ],
  "homepage": "https://github.com/AtharvaN16/forge-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtharvaN16/forge-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/AtharvaN16/forge-terminal/issues"
  },
  "author": "Atharva Nayak",
  "type": "module",
  "bin": {
    "forge": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check src tests scripts extensions",
    "format": "biome format --write src tests scripts extensions",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/word-extractor": "^1.0.6",
    "adm-zip": "^0.6.1",
    "cfb": "^1.2.2",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "docx": "^9.10.0",
    "esbuild": "^0.28.2",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "libheif-js": "^1.23.5",
    "libraw-wasm": "^1.6.0",
    "mammoth": "^1.13.0",
    "onnxruntime-node": "1.23.2",
    "onnxruntime-node-rmbg": "npm:onnxruntime-node@1.25.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "supports-hyperlinks": "^4.6.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "$adm-zip"
    },
    "onnxruntime-node-rmbg": {
      "adm-zip": "$adm-zip"
    }
  }
}
