{
  "name": "forge-terminal",
  "version": "0.1.0",
  "description": "A terminal-native file converter for macOS",
  "keywords": [
    "convert",
    "converter",
    "image",
    "heic",
    "webp",
    "pdf",
    "docx",
    "compress",
    "cli",
    "terminal",
    "tui",
    "macos"
  ],
  "homepage": "https://github.com/AtharvaN16/forge-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtharvaN16/forge-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/AtharvaN16/forge-terminal/issues"
  },
  "author": "Atharva Nayak",
  "type": "module",
  "bin": {
    "forge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "bench": "node scripts/bench.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "prepublishOnly": "rm -rf dist && npm run build && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "adm-zip": "^0.6.0",
    "cfb": "^1.2.2",
    "commander": "^15.0.0",
    "docx": "^9.7.1",
    "ink": "^7.1.1",
    "mammoth": "^1.12.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "sharp": "^0.35.3",
    "string-width": "^8.2.2",
    "supports-hyperlinks": "^4.5.0",
    "tinyglobby": "^0.2.17",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/word-extractor": "^1.0.6",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
