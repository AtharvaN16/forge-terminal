{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shell/**", "!src/shell/Text.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "ink": {
                    "importNames": ["Text"],
                    "message": "Import Text from src/shell/Text.tsx: it owns the foreground where light paints the background."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/*-mockup*.ts", "scripts/*-capture*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    }
  ]
}
