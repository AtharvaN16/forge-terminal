          "lineHeight": 0.031250000000000111,
          "text": "Quarterly Field Report",
          "box": [
            0.072192513118744028, 0.035416666646634565, 0.40641711229946526, 0.031250000000000111
          ],
          "lines": 1
        },
        {
          "kind": "text",
          "title": false,
          "lines": 3,
          "lineHeight": 0.016666666666666607,
          "text": "The survey ran from 3 March to 28 April across four regions. Response rates were higher than expected in the north, where volunteers visited every household twice before marking it as absent.",
          "box": [
            0.069304255971324488, 0.11127934399825656, 0.60187444839885529, 0.069107659657796194
          ]
        },
        {
          "text": "Key findings",
          "box": [
            0.069283189328464168, 0.19272095357555974, 0.15822506460913999, 0.024974759419759129
          ],
          "lines": 1,
          "kind": "text",
          "lineHeight": 0.022916654297151322,
          "title": false
        },
        {
          "title": false,
          "text": "• Water access improved in 62% of villages",
          "kind": "text",
          "lineHeight": 0.016259268168245643,
          "box": [
            0.090804806006781966, 0.22955764904995046, 0.37724981460979279, 0.018554190794626946
          ],
          "lines": 1
        },
        {
          "lineHeight": 0.016423171562094201,
          "box": [
            0.093454368033537974, 0.25564385048642746, 0.36923168814756019, 0.019213988383610991
          ],
          "kind": "text",
          "text": "• Two clinics closed; one reopened in June",
          "title": false,
          "lines": 1
        },
        {
          "lineHeight": 0.015971692799567429,
          "lines": 1,
          "box": [
            0.090791050739241236, 0.27986147752826684, 0.40664383179363717, 0.018546073635419158
          ],
          "title": false,
          "text": "• Average travel time fell from 41 to 27 minutes",
          "kind": "text"
        },
        {
          "lineHeight": 0.016666666666666718,
          "title": false,
          "kind": "text",
          "text": "Contact: field-office@example.org • +1 (415) 555-0134",
