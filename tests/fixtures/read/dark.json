        },
        {
          "box": [
            0.090909093549465206, 0.25624999981770835, 0.37165775401069523, 0.014583333333333282
          ],
          "lineHeight": 0.014583333333333282,
          "text": "• Two clinics closed; one reopened in June",
          "kind": "text",
          "title": false,
          "lines": 1
        },
        {
          "title": false,
          "text": "• Average travel time fell from 41 to 27 minutes",
