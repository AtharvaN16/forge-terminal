        {
          "kind": "text",
          "lineHeight": 0.022916647988219439,
          "title": false,
          "text": "Key findings",
          "box": [
            0.069210730559724515, 0.19238392607878596, 0.15836998230633251, 0.025648814439773626
          ],
          "lines": 1
        },
        {
          "title": false,
          "kind": "text",
          "text": "• Water access improved in 62% of villages",
          "box": [
            0.090804805949509182, 0.22937862327067826, 0.37725160976144717, 0.018733217318852802
          ],
          "lines": 1,
